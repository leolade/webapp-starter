<main class="mx-auto max-w-3xl p-6">
  <h1 class="text-2xl font-semibold">Hello, {{ title() }}</h1>
{{#if mono}}
  <nav aria-label="Main" class="mt-4 flex gap-4">
    <a routerLink="/" class="underline">Home</a>
    <a routerLink="/status" class="underline">API status</a>
{{#if db}}
    <a routerLink="/notes" class="underline">Notes</a>
{{/if}}
{{#if notifs}}
    <a routerLink="/notifications" class="underline">Notifications</a>
{{/if}}
{{#if auth}}
    @if (auth.isSignedIn()) {
      <a routerLink="/account" class="underline">Account</a>
    } @else {
      <a routerLink="/login" class="underline">Sign in</a>
    }
{{/if}}
  </nav>
{{/if}}
  <router-outlet />
</main>
{{#if pwa}}
<app-update-banner />
{{/if}}
